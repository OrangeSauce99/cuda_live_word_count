[info]
title=Live Word Count
desc=Shows word and character count in the bar above text.
type=cudatext-plugin
subdir=live_word_count
homepage=https://github.com/OrangeSauce99/live_word_count
version=1.0.0

[item1]
section=events
events=on_open,on_caret,on_change_slow

[item2]
section=commands
caption=Toggle Live Word Count
method=toggle
hotkey=Ctrl+Shift+W
